generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model applications {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String             @db.Uuid
  resume_id        String?            @db.Uuid
  company_name     String             @db.VarChar(255)
  role_title       String             @db.VarChar(255)
  status           application_status @default(APPLIED)
  applied_date     DateTime           @db.Date
  job_posting_url  String?            @db.VarChar(1024)
  salary_min       Decimal?           @db.Decimal(12, 2)
  salary_max       Decimal?           @db.Decimal(12, 2)
  currency         String?            @default("USD") @db.VarChar(10)
  work_mode        String?            @default("REMOTE") @db.VarChar(20)
  location         String?            @db.VarChar(255)
  job_description  String?
  is_favorite      Boolean            @default(false)
  contact_name     String?            @db.VarChar(255)
  contact_email    String?            @db.VarChar(255)
  rejection_reason String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  resumes          resumes?           @relation(fields: [resume_id], references: [id], onUpdate: NoAction)
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interviews       interviews[]
  notes            notes[]
  offers           offers?

  @@index([status], map: "idx_applications_status")
  @@index([user_id], map: "idx_applications_user_id")
  @@index([user_id, is_favorite], map: "idx_applications_user_favorite")
}

model offers {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id   String       @unique @db.Uuid
  user_id          String       @db.Uuid
  base_salary      Decimal      @default(0) @db.Decimal(12, 2)
  currency         String       @default("USD") @db.VarChar(10)
  bonus            Decimal      @default(0) @db.Decimal(12, 2)
  equity           Decimal      @default(0) @db.Decimal(12, 2)
  work_mode        String       @default("REMOTE") @db.VarChar(20)
  benefits_summary String?
  offer_deadline   DateTime?    @db.Date
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  applications     applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_offers_user_id")
  @@index([application_id], map: "idx_offers_application_id")
}

model interviews {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String       @db.Uuid
  round_type     String       @db.VarChar(100)
  scheduled_at   DateTime     @db.Timestamptz(6)
  outcome        String?      @db.VarChar(50)
  notes          String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_interviews_application_id")
}

model notes {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String       @db.Uuid
  content        String
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_notes_application_id")
}

model resumes {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String         @db.Uuid
  version_label     String         @db.VarChar(100)
  s3_key            String         @db.VarChar(512)
  original_filename String         @db.VarChar(255)
  uploaded_at       DateTime       @default(now()) @db.Timestamptz(6)
  applications      applications[]
  users             users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_resumes_user_id")
}

model users {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(255)
  password_hash String         @db.VarChar(255)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  applications  applications[]
  resumes       resumes[]
  offers        offers[]
}

enum application_status {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}
